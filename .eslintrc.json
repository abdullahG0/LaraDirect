{
  "extends": ["next/core-web-vitals", "next/typescript", "prettier"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/distributor/mock-adapter", "**/distributor/real-adapter"],
            "message": "Import getDistributor() from '@/lib/distributor' instead (spec §3, §18.1)."
          }
        ]
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/distributor/**", "tests/contract/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
