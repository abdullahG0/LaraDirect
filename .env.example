NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SECRET_KEY=
# Server only. Session pooler URI (Supabase > Connect > Session pooler). Used by db:types and the seed script.
SUPABASE_DB_URL=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
RESEND_API_KEY=
# Sender for customer emails, and where admin alerts go (defaults to the company email in settings).
EMAIL_FROM=LaraDirect <orders@laradirect.example>
ADMIN_ALERT_EMAIL=
# Required for /api/cron/*. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
DISTRIBUTOR_MODE=mock            # mock | real
DEMO_TIME_SCALE=1                # 60 = fast-forward order progress
MOCK_FAIL_RATE=0.03
MOCK_REJECT_SKUS=
MOCK_PRICE_TOLERANCE_PCT=1
CATALOGUE_SEED=laradirect-2026
# Mock distributor state lives in Supabase (mock_distributor_state). Set to "file" to use .data/ locally instead.
MOCK_STATE_STORE=
TDS_BASE_URL=
TDS_CLIENT_ID=
TDS_CLIENT_SECRET=
TDS_CUSTOMER_NUMBER=
VAT_RATE=0.20
